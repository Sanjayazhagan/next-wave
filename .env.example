# --- WhatsApp ---
# Meta app dashboard > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=

# Meta app dashboard > App settings > Basic > App secret
WHATSAPP_APP_SECRET=

# Business Settings > System users > Generate token
WHATSAPP_ACCESS_TOKEN=

# Any long random string. Paste the same value into Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=

# --- Telegram ---
# From @BotFather. Telegram stays off until the token and secret are both set.
TELEGRAM_BOT_TOKEN=

# Any long random string, using letters, numbers, - and _ only.
TELEGRAM_WEBHOOK_SECRET=

# This server's HTTPS address, so it can register its Telegram webhook on startup.
PUBLIC_URL=

# --- Security ---
# Base64 of 32 random bytes. Generate once and back it up: losing it loses the vault.
# python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
VAULT_KEY=

# The web app sends this as the X-API-Key header.
API_TOKEN=

# --- LLM ---
# Any OpenAI-compatible service. Groq is fast and sees all chat text, so choose a
# provider you trust.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b

# To use the freellmpool proxy instead, set LLM_BASE_URL=http://localhost:8080/v1 and
# LLM_MODEL=auto. Its keyless routes are slower and often logged. The container
# starts it by itself when LLM_BASE_URL points at localhost.

# --- Other services (blank until they are ready) ---
LANGUAGE_SERVICE_URL=
BROWSER_WORKER_URL=

# The browser service in browser-product/. Set both to use its real Chromium browser
# on its fictional scholarship portal. Its INTERNAL_KEY is the key here.
BROWSER_PRODUCT_URL=
BROWSER_PRODUCT_KEY=
# portal = its fixed mock portal. general = real pages, step by step.
BROWSER_PRODUCT_MODE=portal
# For general mode, for example: {"nsp": "https://scholarships.gov.in/"}
PORTAL_URLS={}
# The browser service's own upload ceiling. Each form's rules are read from the form.
BROWSER_UPLOAD_MAX_BYTES=1048576
CORS_ORIGINS=

# --- Portals ---
# Used when the rule engine is not merged yet.
DEFAULT_PORTAL_ID=demo_portal

# true runs a fake portal and fake extraction, to try the loop end to end.
USE_STANDINS=true

# Keep false unless the applicant genuinely qualifies. When false the agent
# stops at the review page and never presses final submit.
ALLOW_REAL_SUBMIT=false

# --- Remote modules (extraction, language, rules, doctor, compressor) ---
# A vision-capable model on LLM_BASE_URL, for reading document photos.
# Groq's qwen/qwen3.8-27b takes images (max 3 per request) and JSON mode.
VISION_MODEL=qwen/qwen3.8-27b
# Scratch and log folders for the modules. Logs hold no document text.
WORK_DIR=./work
LOG_DIR=./logs

# Language service (modules/language). Core reaches it through LANGUAGE_SERVICE_URL.
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_ID=
SARVAM_API_KEY=
LANG_PRIMARY=bhashini            # bhashini | sarvam
STT_PRIMARY=                     # optional override for speech-to-text only
STT_DEFAULT_LANG=ta              # Bhashini needs a language; Sarvam auto-detects
SARVAM_STT_MODE=                 # optional, e.g. codemix for Tamil-English speech
PROVIDER_TIMEOUT_S=5
STT_TIMEOUT_S=15

# Rule engine: when set, schemes keep their real names and cited rules, but the
# browser is sent to this portal (the practice portal) instead of the real one.
# Use the same portal id as DEFAULT_PORTAL_ID for the demo; leave blank for real portals.
DEMO_PORTAL_ID=
