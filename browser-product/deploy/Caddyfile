{
    email {$ACME_EMAIL}
}

{$DEMO_HOST} {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        -Server
    }

    # Server-to-server LangGraph integration: key-authenticated inside FastAPI.
    # Caddy basic auth would otherwise block main's HTTP client. NEVER place
    # INTERNAL_KEY in client-side JS, URLs or Git. Restrict ingress if possible.
    @core path /core-browser/*
    handle @core {
        reverse_proxy api:8000 {
            flush_interval -1
        }
    }

    # Short-lived, scoped, human-only verification link. Bearer token must be
    # supplied in X-Assist-Token from fragment-backed JS (never URL query).
    # No service key or public browser-control endpoint is exposed here.
    # The bare /core-assist/ landing page is safe and contains no session.
    # Real handoffs use /core-assist/<task-id>#<fragment-token>.
    @human path /core-assist/ /core-assist/* /core-assist.js /core-assist.css
    handle @human {
        reverse_proxy api:8000
    }

    # Human UI and all remaining routes retain a second layer of basic auth.
    # Signed application identity is additionally required in integrated mode.
    handle {
        basic_auth {
            {$DEMO_USER} {$DEMO_PASSWORD_HASH}
        }
        reverse_proxy api:8000 {
            flush_interval -1
        }
    }
}
