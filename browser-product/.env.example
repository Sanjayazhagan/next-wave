# ONLY FOR LOCAL / MOCK DEMO. NEVER publicly expose this configuration.
APP_MODE=demo
MOCK_BASE_URL=http://127.0.0.1:8100
WORKER_URL=http://127.0.0.1:8101
CHROMIUM_PATH=/usr/bin/chromium
DATABASE_PATH=data/demo.db
INTERNAL_KEY=demo-worker-key-change-before-production
APP_SIGNING_KEY=demo-signing-key-change-before-production
# Optional identity integration. Core signs short-lived audience-bound assertions.
# Local demo remains synthetic even when identity protection is enabled.
SECURITY_MODE=local-demo
IDENTITY_SIGNING_KEY=
MAX_BROWSER_SESSIONS=8
# Comma-separated Fernet keys; first encrypts new data, others decrypt old data.
# Generate locally with scripts/configure_local.py; never commit real keys.
DATA_ENCRYPTION_KEYS=
WHATSAPP_RETURN_URL=
MAX_REQUEST_BYTES=2097152
REQUEST_BODY_TIMEOUT_SECONDS=15
# General browser v2: operator-reviewed exact origins only. Empty uses MOCK_BASE_URL.
# Do not add real sites without verifying authorization and adapter requirements.
# BROWSER_ALLOWED_ORIGINS=http://127.0.0.1:8100

# === Main LangGraph / real-page integration (operator-managed) ===
# Do not activate without authenticated reverse proxy, explicit permission to
# automate the target portal, and verification of all irreversible actions.
# APP_MODE=integrated
# SECURITY_MODE=signed
# BROWSER_ALLOWED_ORIGINS=https://authorized-portal.example
# Exact portal registry: MUST be JSON. Each entry has URL and optionally a
# reviewed receipt_pattern with a capturing group (no fabricated receipts).
# BROWSER_PORTALS_JSON={"scholarship":{"url":"https://authorized-portal.example/"}}
# BROWSER_ALLOW_FORM_POST=false
# BROWSER_ENABLE_FINAL_SUBMIT=false
# All of these must be configured securely on the main API (NOT in JS):
# BROWSER_WORKER_URL=https://browser.yourdomain.example/core-browser
# BROWSER_WORKER_KEY=<same strong INTERNAL_KEY as browser service>
