{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document extraction output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "file_ref",
    "fields"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "document_type": {
      "type": "string"
    },
    "file_ref": {
      "type": "string"
    },
    "fields": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "value",
          "source_document",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "source_document": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
