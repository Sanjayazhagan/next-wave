{
  "$defs": {
    "BrowserAction": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "maxLength": 100,
          "minLength": 8,
          "title": "Action Id",
          "type": "string"
        },
        "observation_id": {
          "maxLength": 100,
          "title": "Observation Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "click",
            "fill",
            "select",
            "check",
            "upload",
            "navigate",
            "back",
            "scroll",
            "wait",
            "switch_tab",
            "extract",
            "blur"
          ],
          "title": "Kind",
          "type": "string"
        },
        "target_ref": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Ref"
        },
        "value": {
          "default": "",
          "maxLength": 2000,
          "title": "Value",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Values",
          "type": "array"
        },
        "url": {
          "default": "",
          "maxLength": 2000,
          "title": "Url",
          "type": "string"
        },
        "tab_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tab Id"
        },
        "source_ref": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ref"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        },
        "checked": {
          "default": true,
          "title": "Checked",
          "type": "boolean"
        },
        "scroll_y": {
          "default": 500,
          "maximum": 2000,
          "minimum": -2000,
          "title": "Scroll Y",
          "type": "integer"
        },
        "timeout_ms": {
          "default": 5000,
          "maximum": 15000,
          "minimum": 100,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "artifact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        }
      },
      "required": [
        "action_id",
        "observation_id",
        "kind"
      ],
      "title": "BrowserAction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "outcome": {
      "enum": [
        "act",
        "needs_information",
        "needs_human",
        "needs_review",
        "done"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "summary": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "action": {
      "anyOf": [
        {
          "$ref": "#/$defs/BrowserAction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "requested_fields": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Requested Fields",
      "type": "array"
    }
  },
  "required": [
    "outcome",
    "summary"
  ],
  "title": "ModelDecision",
  "type": "object"
}
