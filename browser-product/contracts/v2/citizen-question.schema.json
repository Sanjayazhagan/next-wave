{
  "additionalProperties": false,
  "properties": {
    "name": {
      "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,49}$",
      "title": "Name",
      "type": "string"
    },
    "label": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "kind": {
      "default": "text",
      "enum": [
        "text",
        "number",
        "date",
        "choice",
        "artifact"
      ],
      "title": "Kind",
      "type": "string"
    },
    "required": {
      "default": true,
      "title": "Required",
      "type": "boolean"
    },
    "choices": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "title": "Choices",
      "type": "array"
    }
  },
  "required": [
    "name",
    "label"
  ],
  "title": "Question",
  "type": "object"
}
