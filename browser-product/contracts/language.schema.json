{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Language endpoints for STT/TTS/translation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "language"
  ],
  "properties": {
    "operation": {
      "enum": [
        "stt",
        "translate",
        "tts"
      ]
    },
    "language": {
      "type": "string"
    },
    "target_language": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "audio_ref": {
      "type": "string"
    },
    "result_ref": {
      "type": "string"
    }
  }
}
