# Copy into .env ON THE VM. Synthetic demo only. Never commit .env.
# All below values must be customized before deploy.
DEMO_HOST=demo.your-domain.example
ACME_EMAIL=your-email@example.org
DEMO_USER=gradientzero
# Caddy bcrypt hash, not plaintext! If hash contains $, enclose in SINGLE quotes.
DEMO_PASSWORD_HASH='$2a$12$REPLACE_WITH_REAL_CADDY_BCRYPT_HASH'
# Generate independently with: openssl rand -hex 32
INTERNAL_KEY=REPLACE_WITH_64_HEX_RANDOM_BYTES
APP_SIGNING_KEY=REPLACE_WITH_DIFFERENT_64_HEX_RANDOM_BYTES
APP_MODE=demo
# Optional signed identity integration requires independent configured keys.
SECURITY_MODE=local-demo
IDENTITY_SIGNING_KEY=
DATA_ENCRYPTION_KEYS=
WHATSAPP_RETURN_URL=
